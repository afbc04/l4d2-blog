extends ../layout

block content
  .login-wrapper(style="position:relative; display:flex; flex-direction:column; align-items:center; min-height:100vh; padding:50px 0; gap:20px;")
    .background(style="position:fixed; top:0; left:0; width:100%; height:100vh; background:url('/images/bragaCentro.jpg') center/cover no-repeat; filter:blur(8px); z-index:0;")

    .w3-card-4(style="position:relative; z-index:1; width:900px; padding:15px 25px; border-radius:12px; background:rgba(255,255,255,0.9); display:flex; justify-content:space-between; align-items:center;")
      div.nav-icons
        a(href="/" data-tooltip="Home")
          i.fa-solid.fa-house
        a(href="/info" data-tooltip="Info")
          i.fa-solid.fa-circle-question
        a(href="/about" data-tooltip="About")
          i.fa-solid.fa-circle-info
        a(href="/users" data-tooltip="People")
          i.fa-solid.fa-users
        a(href="/birthdays" class="active" data-tooltip="Birthdays")
          i.fa-solid.fa-cake-candles
        a(href="https://github.com/afbc04/l4d2-blog" target="_blank" data-tooltip="GitHub")
          i.fa-brands.fa-github
        if user
          if user.rank == "A"
            a(href="/users/waitingApproval" data-tooltip="Approve accounts")
              i.fa-solid.fa-user-check

      div(style="display:flex; gap:10px; align-items:center;")
        if user
          div(style="display:flex; align-items:center; gap:10px;")
            a(href=`/users/details/${user._id}` style="font-weight:500; font-size:1rem; color:#444; text-decoration:none;")= user._id
            img(src=user.profilePicture || '/images/panado.jpg' style="width:32px; height:32px; border-radius:50%;")
            a(href="/auth/logout" style="color:#666; font-size:0.85rem; text-decoration:none;") 
              i.fa-solid.fa-door-open
        else
          div(style="display:flex; gap:12px; align-items:center;")
            a(href="/users/create" style="padding:6px 14px; background:#f0f0f0; color:#333; text-decoration:none; border-radius:6px; font-weight:500;")
              | Create account
            a(href="/auth/login" style="padding:6px 14px; background:#008080; color:#fff; text-decoration:none; border-radius:6px; font-weight:500;")
              | Login

    .w3-card-4(style="position:relative; z-index:1; width:650px; padding:30px; border-radius:12px; box-shadow:0 12px 35px rgba(0,0,0,0.25); background: rgba(255,255,255,0.85); display:flex; flex-direction:column; gap:20px;")
      
      h2(style="text-align:center; color:#008080; font-size:2rem; margin-bottom:10px;")
        | Birthdays

      if birthdays.length
        each b in birthdays
          .w3-card-4(style="padding:20px; border-radius:12px; box-shadow: 0 8px 25px rgba(0,0,0,0.15); background:#fafafa; display:flex; align-items:center; gap:15px;")

            img(
              src=b.user.profilePicture || '/images/panado.jpg',
              style="width:70px;height:70px;border-radius:50%;object-fit:cover;border:3px solid #eee"
            )

            .user-info(style="display:flex; flex-direction:column; gap:6px; flex:1;")
              
              h3(style="margin:0; font-size:1.1rem;")
                a(
                  href=`/users/details/${b.user._id}`,
                  style="color:inherit; text-decoration:none;"
                )
                  if b.user.realName
                    | #{b.user.realName}
                    span(style="color:#888; font-size:0.9rem;")  (#{b.user.name})
                  else
                    | #{b.user.name}

              span(style="font-size:0.9rem; color:#444;")
                strong #{b.birthday}
                if b.futureAge
                  |  — going to be #{b.futureAge} years old

      if noBirthday.length
        h3(style="margin-top:10px; color:#888; font-size:1rem;")
          | Unknown birthdays

        each u in noBirthday
          .w3-card-4(style="padding:20px; border-radius:12px; box-shadow: 0 8px 25px rgba(0,0,0,0.15); background:#fafafa; display:flex; align-items:center; gap:15px;")

            img(
              src=u.profilePicture || '/images/panado.jpg',
              style="width:70px;height:70px;border-radius:50%;object-fit:cover;border:3px solid #eee"
            )

            .user-info(style="display:flex; flex-direction:column; gap:6px; flex:1;")
              
              h3(style="margin:0; font-size:1.1rem;")
                a(
                  href=`/users/details/${u._id}`,
                  style="color:inherit; text-decoration:none;"
                )
                  if u.realName
                    | #{u.realName}
                    span(style="color:#888; font-size:0.9rem;")  (#{u.name})
                  else
                    | #{u.name}

              span(style="font-size:0.9rem; color:#444;")
                i ???