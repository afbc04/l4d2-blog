extends ../layout

block content
  .login-wrapper(style="position:relative; display:flex; justify-content:center; align-items:center; min-height:100vh;")
    .background(style="position:absolute; top:0; left:0; width:100%; height:100%; background:url('/images/favicon.jpg') center/cover no-repeat; filter:blur(8px); z-index:0;")
    
    .w3-card-4(style="position:relative; z-index:1; width:400px; padding:30px; border-radius:12px; box-shadow: 0 8px 25px rgba(0,0,0,0.15); background:#ffffff;")
      
      .header(style="text-align:center; margin-bottom:20px;")
        h2(style="color:#008080; font-family: 'Segoe UI', sans-serif;") Too Many Attempts
        p(style="color:#666; font-size:0.9rem; margin-top:5px;") You have exceeded the maximum number of login attempts. Please try again later.

      if retryAfter
        p(style="text-align:center; color:#555; font-size:0.85rem; margin-top:10px;") 
          | Try again in #{Math.ceil(retryAfter / 60)} minutes.

      .w3-center(style="margin-top:20px;")
        a.w3-button(href="/auth/login", style="width:100%; padding:12px; background:#008080; color:white; border:none; border-radius:6px; font-size:1rem; cursor:pointer; transition: background 0.3s;") Back to Login

      hr(style="margin:25px 0; border-color:#eee;")

      p(style="text-align:center; font-size:0.85rem; color:#aaa;") @afbc04