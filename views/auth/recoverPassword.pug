extends ../layout

block content
  .login-wrapper(style="position:relative; display:flex; justify-content:center; align-items:center; min-height:100vh;")
    .background(style="position:absolute; top:0; left:0; width:100%; height:100%; background:url('/images/favicon.jpg') center/cover no-repeat; filter:blur(8px); z-index:0;")
    
    .w3-card-4(style="position:relative; z-index:1; width:400px; padding:30px; border-radius:12px; box-shadow: 0 8px 25px rgba(0,0,0,0.15); background:#ffffff;")

      a(
        href="javascript:history.back()",
        style="position:absolute; top:20px; left:25px; color:#008080; font-size:0.9rem; text-decoration:none; font-weight:500;") Go back

      .header(style="text-align:center; margin-bottom:20px;")
        h2(style="color:#008080; font-family: 'Segoe UI', sans-serif;") Recover Password
        p(style="color:#666; font-size:0.9rem; margin-top:5px;")
          | Enter your email and we'll send you a reset link
        p(style="font-size:0.9rem; margin-top:5px;")
          | It's crucial that your account has an 
          strong email 
          | on it.
        h1(style="color:#666; font-size:0.9rem; margin-top:5px;")
          | If your account does not have an email, contact us

      if success
        .w3-panel(style="background:#e6f7f7; color:#006666; border-left:5px solid #008080; padding:10px; margin-bottom:15px; border-radius:6px; text-align:center;")
          | If the email exists, a recovery link has been sent.

      if error
        .w3-panel(style="background:#fdecea; color:#b00020; border-left:5px solid #b00020; padding:10px; margin-bottom:15px; border-radius:6px; text-align:center;")
          = error

      form(method="POST" action="/auth/recoverPassword")
        .form-group(style="margin-bottom:15px;")
          label(for="email", style="font-weight:600;") Email
          input.w3-input(
            type="email",
            id="email",
            name="email",
            placeholder="Enter your email",
            required,
            style="width:100%; padding:10px; border-radius:6px; border:1px solid #ccc; font-size:1rem;"
          )

        button.w3-button(
          type="submit",
          style="width:100%; padding:12px; background:#008080; color:white; border:none; border-radius:6px; font-size:1rem; cursor:pointer; transition: background 0.3s;"
        ) Send Recovery Email

      p(style="text-align:center; margin-top:15px; font-size:0.85rem; color:#555;")
        a(href="/auth/login" style="color:#008080; text-decoration:underline;") Back to login

      hr(style="margin:25px 0; border-color:#eee;")

      p(style="text-align:center; font-size:0.85rem; color:#aaa;") @afbc04