extends ../layout

block content
  .login-wrapper(style="position:relative; display:flex; justify-content:center; align-items:flex-start; min-height:100vh; padding:50px 0;")
    
    .background(style="position:fixed; top:0; left:0; width:100%; height:100vh; background:url('/images/bragaCentro.jpg') center/cover no-repeat; filter:blur(8px); z-index:0;")
    .w3-card-4(style="position:relative; z-index:1; width:800px; padding:40px; border-radius:12px; box-shadow: 0 12px 35px rgba(0,0,0,0.25); background:#ffffff;")

      a(
        href="javascript:history.back()",
        style="position:absolute; top:20px; left:25px; color:#008080; font-size:0.9rem; text-decoration:none; font-weight:500;"
      ) Go back

      a(
        href="/users",
        style="position:absolute; top:20px; left:100px; color:#555; font-size:0.9rem; text-decoration:none; font-weight:500;"
      ) Meet more people

      .header(style="text-align:center; margin-bottom:25px;")
        if user.realName
          h2(style="color:#008080; font-family:'Segoe UI', sans-serif; font-size:1.8rem;") 
            | #{user.realName}
            span(style="color:#888; font-family:'Segoe UI', sans-serif; font-size:1.6rem; margin-left:6px;") (#{user.name})
        else
          h2(style="color:#008080; font-family:'Segoe UI', sans-serif; font-size:1.8rem;") #{user.name}

      .w3-center(style="margin-bottom:25px;")
        img(
          src=user.profilePicture || '/images/panado.jpg',
          style="width:130px;height:130px;border-radius:50%;object-fit:cover;border:3px solid #eee"
          draggable="false",
          oncontextmenu="return false;"
        )

      .w3-center(style="margin-bottom:10px;display:flex; justify-content:center; gap:20px; margin-top:15px; flex-wrap:wrap;")
        
        if viewer._id == user._id
          a(
            href=`/users/edit/${user._id}`,
            style="color:#2564da; font-size:0.9rem; text-decoration:none; font-weight:500; transition:color 0.2s;",
            onmouseover="this.style.color='#114199'",
            onmouseout="this.style.color='#2564da'"
          ) Edit information

        if viewer._id == user._id || viewer.rank == 'A'
          a(
            href=`/users/delete/${user._id}`,
            style="color:#f44336; font-size:0.9rem; text-decoration:none; font-weight:500; transition:color 0.2s;",
            onmouseover="this.style.color='#a31f1f'",
            onmouseout="this.style.color='#f44336'"
          ) Terminate account

        if viewer._id == user._id
          a(
            href=`/users/change-password/${user._id}`,
            style="color:#8d8d8d; font-size:0.9rem; text-decoration:none; font-weight:500; transition:color 0.2s;",
            onmouseover="this.style.color='#494949'",
            onmouseout="this.style.color='#8d8d8d'"
          ) Change password

      .w3-card-4(style="padding:25px; background:#fafafa; border-radius:8px; box-shadow: inset 0 0 8px rgba(0,0,0,0.03);")

        fieldset(style="border:none; display:flex; flex-direction:column; gap:18px;")
          legend(style="font-weight:bold; font-size:1.1rem; margin-bottom:10px; color:#444;") Account Information

          div(style="margin-bottom:10px;")
            label.w3-text-gray
              b Role
            .w3-input
              if user.rank === "A"
                b 
                  span(style="font-size:1rem; font-weight:500; color:#ed2b2b;") Administrator
              else
                span(style="font-size:0.95rem; font-weight:500; color:#008080;") Regular User

          div
            label.w3-text-gray
              b Created By
            .w3-input.w3-round
              if !user.createdBy
                span.w3-text-gray First user of system
              else
                a(href=`/users/details/${user.createdBy}`)= user.createdBy

          - const createdDate = new Date(user.creationDate)
          - const formattedDate = createdDate.toLocaleString('pt-PT', { day: '2-digit',  month: '2-digit',  year: 'numeric',  hour: '2-digit',  minute: '2-digit', second: '2-digit',  hour12: false})
          div
            label.w3-text-gray
              b Creation Date
            input.w3-input.w3-round(
              type="text",
              value=formattedDate,
              readonly,
              style="margin-top:5px; background:#fff;"
            )

          div(style="margin-bottom:10px; display:flex; flex-direction:column;")
            label.w3-text-gray
              b Country
            if user.location
              - const countryCode = user.location.toLowerCase()
              span(style="display:inline-flex; align-items:center; gap:6px; color:#333; padding:4px 10px; border-radius:12px; font-size:0.95rem; font-weight:500;")
                img(src=`https://flagpedia.net/data/flags/h80/${countryCode}.png`, alt=`${countryName} Flag`, width="20", height="14", style="border:1px solid #ccc; border-radius:2px;")
                | #{countryName}
            else
              span(style="display:inline-block; color:#999; padding:4px 10px; border-radius:12px; font-size:0.95rem; font-weight:500;")
                | Unknown

          div(style="margin-bottom:10px; display:flex; flex-direction:column;")
            label.w3-text-gray
              b Birth Date
            if birthDate
              input.w3-input.w3-round(
                type="text",
                value=birthDate ? birthDate : 'Not provided',
                readonly,
                style="margin-top:5px; background:#fff;"
              )
              if age
                span(style="margin-left:10px; font-size:0.85rem; color:#555; font-weight:500;") (#{age} years old)
            else
              span(style="display:inline-block; color:#999; padding:4px 10px; border-radius:12px; font-size:0.95rem; font-weight:500;")
                | Not provided

          div
            label.w3-text-gray
              b Status      
              if user.active
                span(style="background:#e8f5e9; color:#388e3c; padding:4px 10px; border-radius:12px; font-size:0.85rem; font-weight:500; display:inline-block;")
                  | Active
              else
                span(style="background:#ffebee; color:#d32f2f; padding:4px 10px; border-radius:12px; font-size:0.85rem; font-weight:500; display:inline-block;")
                  | Terminated

      if !user.active
        - const deletionDate = user.deletionDate ? new Date(user.deletionDate) : null

        .w3-card-4(style="margin-top:20px;padding:25px; background:#fafafa; border-radius:8px; box-shadow: inset 0 0 8px rgba(0,0,0,0.03); border-left:5px solid #f44336; border-radius:8px;")
          legend(style="font-weight:bold; font-size:1.1rem; margin-bottom:10px; color:#444;") Termination Details

          .w3-margin-bottom
            label.w3-text-gray
              b Reason
            .w3-input.w3-round(style="margin-top:5px; background:#fff;")
              if user.deletionReason
                | #{user.deletionReason}
              else
                span(style="display:inline-block; color:#999; padding:4px 10px; border-radius:12px; font-size:0.95rem; font-weight:500;")
                  | Not provided

          .w3-margin-bottom
            label.w3-text-gray
              b By
            .w3-input.w3-round(style="margin-top:5px; background:#fff;")
              if user.deletedBy === user._id
                span(style="display:inline-block; color:#999; padding:4px 10px; border-radius:12px; font-size:0.95rem; font-weight:500;")
                  | Terminated by own user
              else
                a(href=`/users/details/${user.deletedBy}`)= user.deletedBy

          .w3-margin-bottom
            - const formattedDeletionDate = deletionDate ? deletionDate.toLocaleString('pt-PT', {   day: '2-digit',   month: '2-digit',   year: 'numeric',   hour: '2-digit',   minute: '2-digit',   second: '2-digit',   hour12: false }) : 'Unknown'

            div
              label.w3-text-gray
                b Date
              input.w3-input.w3-round(
                type="text",
                value=formattedDeletionDate,
                readonly,
                style="margin-top:5px; background:#fff;"
              )