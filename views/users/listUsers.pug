extends ../layout

block content
  .login-wrapper(style="position:relative; display:flex; flex-direction:column; align-items:center; min-height:100vh; padding:50px 0; gap:20px;")
    .background(style="position:fixed; top:0; left:0; width:100%; height:100vh; background:url('/images/bragaCentro.jpg') center/cover no-repeat; filter:blur(8px); z-index:0;")

    .w3-card-4(style="position:relative; z-index:1; width:900px; padding:15px 25px; border-radius:12px; background:rgba(255,255,255,0.9); display:flex; justify-content:space-between; align-items:center;")

      div.nav-icons
        a(href="/" data-tooltip="Home")
          i.fa-solid.fa-house

        a(href="/info" data-tooltip="Info")
          i.fa-solid.fa-circle-question

        a(href="/about" data-tooltip="About")
          i.fa-solid.fa-circle-info

        a(href="/users" class="active" data-tooltip="People")
          i.fa-solid.fa-users

        a(href="/birthdays" data-tooltip="Birthdays")
          i.fa-solid.fa-cake-candles

        a(href="https://github.com/afbc04/l4d2-blog" target="_blank" data-tooltip="GitHub")
          i.fa-brands.fa-github

        if user
          if user.rank == "A"
            a(href="/users/get-registration-token" data-tooltip="Create Registration Code")
              i.fa-solid.fa-ticket

      div(style="display:flex; gap:10px; align-items:center;")
        if user
          div(style="display:flex; align-items:center; gap:10px;")

            a(
              href=`/users/details/${user._id}`
              style="font-weight:500; font-size:1rem; color:#444; text-decoration:none;"
              onmouseover="this.style.textDecoration='underline'"
              onmouseout="this.style.textDecoration='none'"
            )= user._id

            img(
              src=user.profilePicture || '/images/panado.jpg'
              style="width:32px; height:32px; border-radius:50%;"
            )

            a(
              href="/auth/logout"
              style="color:#666; font-size:0.85rem; text-decoration:none;"
              onmouseover="this.style.textDecoration='underline'"
              onmouseout="this.style.textDecoration='none'"
            ) 
              i.fa-solid.fa-door-open
        else
          div(style="display:flex; gap:12px; align-items:center;")
            a(href="/users/create", style="padding:6px 14px; background:#f0f0f0; color:#333; text-decoration:none; border-radius:6px; font-weight:500; font-size:0.95rem; transition:background 0.2s;")
              | Create account
            
            a(href="/auth/login", style="padding:6px 14px; background:#008080; color:#fff; text-decoration:none; border-radius:6px; font-weight:500; font-size:0.95rem; transition:background 0.2s;")
              | Login

    .w3-card-4(style="position:relative; z-index:1; width:650px; padding:30px; border-radius:12px; box-shadow:0 12px 35px rgba(0,0,0,0.25); background: rgba(255, 255, 255, 0.85); display:flex; flex-direction:column; gap:20px;")
      
      h2(style="text-align:center; color:#008080; font-family:'Segoe UI', sans-serif; font-size:2rem; margin-bottom:20px;")
        | Meet our people

      each u in users
        .w3-card-4(style="padding:20px; border-radius:12px; box-shadow: 0 8px 25px rgba(0,0,0,0.15); background:#fafafa; display:flex; gap:15px; align-items:center;")
          
          img(
            src=u.profilePicture || '/images/panado.jpg',
            style="width:80px;height:80px;border-radius:50%;object-fit:cover;border:3px solid #eee",
            draggable="false",
            oncontextmenu="return false;"
          )

          .user-info(style="display:flex; flex-direction:column; gap:5px;")
            h3(style="margin:0; font-size:1.2rem;")
              a(
                href=`/users/details/${u._id}`,
                style="color:#008080; text-decoration:none;"
              )
                if u.realName
                  | #{u.realName} 
                  span(style="font-size:0.95rem; color:#888; margin-left:5px;") (#{u.name})
                else
                  | #{u.name}

              if u.location
                - const countryCode = u.location.toLowerCase()
                span(style="margin-left:5px;display:inline-flex; align-items:center; gap:6px; color:#333; font-size:0.85rem;")
                  img(src=`https://flagpedia.net/data/flags/h80/${countryCode}.png`, alt=`${countryCode} Flag`, width="20", height="14", style="border:1px solid #ccc; border-radius:2px;")

              if u.rank === "A"
                span(style="font-size:0.90rem; font-weight:500; color:#ed2b2b; margin-left:10px;") Administrator

            - const createdDate = new Date(u.creationDate)
            - const formattedDate = createdDate.toLocaleString('pt-PT', { day: '2-digit', month: '2-digit', year: 'numeric'})
            span(style="font-size:0.85rem; color:#666;")
              | Joined in #{formattedDate}

            span(style="font-size:0.85rem;")
              if u.active
                span(style="background:#e8f5e9; color:#388e3c; padding:4px 10px; border-radius:12px; font-size:0.85rem; font-weight:500; display:inline-block;")
                  | Active
              else
                span(style="background:#ffebee; color:#d32f2f; padding:4px 10px; border-radius:12px; font-size:0.85rem; font-weight:500; display:inline-block;")
                  | Terminated

          a(
            href=`/users/details/${u._id}`,
            style="margin-left:auto; color:#888; font-size:0.85rem; text-decoration:none; transition:color 0.2s;"
            onmouseover="this.style.color='#008080'"
            onmouseout="this.style.color='#888'"
          ) View profile