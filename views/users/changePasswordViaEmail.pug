extends ../layout

block content
  .login-wrapper(style="position:relative; display:flex; justify-content:center; align-items:center; min-height:100vh;")
    .background(style="position:absolute; top:0; left:0; width:100%; height:100%; background:url('/images/bragaCentro.jpg') center/cover no-repeat; filter:blur(8px); z-index:0;")
    
    .w3-card-4(style="position:relative; z-index:1; width:450px; padding:30px; border-radius:12px; box-shadow: 0 8px 25px rgba(0,0,0,0.15); background:#ffffff;")
      
      .header(style="text-align:center; margin-bottom:20px;")
        h2(style="color:#008080; font-family: 'Segoe UI', sans-serif;") Change Password
        
        img#previewAvatar(
            src=(user && user.profilePicture) || '/images/panado.jpg'
            style="width:120px;height:120px;border-radius:50%;object-fit:cover;border:3px solid #eee",
            draggable="false",
            oncontextmenu="return false;"
        )

      form#changePasswordForm(method="POST")
        label.w3-text-gray(style="margin-top:15px;")
          b New Password
        input.w3-input.w3-round(
          type="password",
          name="password",
          placeholder="Enter new password",
          required
        )

        .confirmation(style="margin-top:20px; text-align:center;")

          .w3-center(style="display:flex; justify-content:center; gap:15px; flex-wrap:wrap; margin-top:10px;")
            a.w3-button.w3-round(
              href=`/`,
              style="padding:10px 18px; background:#607d8b; color:white;"
            ) Cancel

            button.w3-button.w3-round(
              type="submit",
              href=`/`,
              style="padding:10px 18px; background:#008080; color:white;"
            ) Change Password